<script src="script.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {

    const activityList =
        document.getElementById("loginActivityList");

    const history =
        JSON.parse(
            localStorage.getItem("aiLearnLoginHistory") || "[]"
        );

    if (!activityList) return;

    if (history.length === 0) {

        activityList.innerHTML = `
            <div class="empty-activity">
                <div class="activity-icon">🔐</div>
                <div>
                    <strong>No login activity yet</strong>
                    <p>Your recent login activity will appear here.</p>
                </div>
            </div>
        `;

        return;
    }

    activityList.innerHTML = "";

    history
        .slice()
        .reverse()
        .slice(0, 5)
        .forEach(function (activity) {

            const item = document.createElement("div");

            item.className = "activity-item";

            item.innerHTML = `
                <div class="activity-icon">
                    🔐
                </div>

                <div class="activity-details">
                    <strong>
                        ${activity.name || "Student"}
                    </strong>

                    <span>
                        ${activity.email || "Unknown email"}
                    </span>

                    <small>
                        ${activity.time || "Recently"}
                    </small>
                </div>

                <div class="activity-status">
                    <span>Active</span>
                </div>
            `;

            activityList.appendChild(item);
        });

});
</script>
